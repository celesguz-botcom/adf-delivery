{
	"name": "df_restaurantes",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "restaurantes_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "derivedColumn1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          restaurante_id as string,",
				"          nombre_restaurante as string,",
				"          tipo_cocina as string,",
				"          calificacion_promedio as string,",
				"          activo as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 derive(activo = iif(trim(lower(activo))=='activo','Si',trim(activo)),",
				"          nombre_restaurante = iif(isNull(nombre_restaurante), concat('Restaurante_', restaurante_id), trim(nombre_restaurante)),",
				"          calificacion_promedio = iif(toDecimal(calificacion_promedio)> 5,5.0,toFloat(calificacion_promedio))) ~> derivedColumn1"
			]
		}
	}
}