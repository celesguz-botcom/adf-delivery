{
	"name": "df_promociones",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "promociones_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "filter1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          promocion_id as string,",
				"          nombre_promocion as string,",
				"          fecha_inicio as string,",
				"          fecha_fin as string,",
				"          porcentaje_descuento as string,",
				"          canal_aplicable as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 derive(porcentaje_descuento = iif(toFloat(porcentaje_descuento) > 100, 100.0, iif(toFloat(porcentaje_descuento) < 0, 0.0,toFloat(porcentaje_descuento))),",
				"          canal_aplicable = iif(isNull(canal_aplicable), 'Todos', trim(canal_aplicable))) ~> derivedColumn1",
				"derivedColumn1 filter(fecha_fin >= fecha_inicio) ~> filter1"
			]
		}
	}
}