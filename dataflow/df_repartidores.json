{
	"name": "df_repartidores",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "repartidores_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "derivedColumn1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          repartidor_id as string,",
				"          nombre_repartidor as string,",
				"          tipo_vehiculo as string,",
				"          ciudad_base as string,",
				"          fecha_alta as string,",
				"          activo as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 derive(ciudad_base = iif(trim(upper(ciudad_base))=='CBA', 'Cochabamba', iif(isNull(ciudad_base), 'Sin ciudad', trim(ciudad_base))),",
				"          fecha_alta = iif(regexMatch(fecha_alta,'^[0-9]{2}/[0-9]{2}/[0-9]{4}$'),concat(substring(fecha_alta,7,4), '-', substring(fecha_alta,4,2), '-', substring(fecha_alta,1,2)),fecha_alta)) ~> derivedColumn1"
			]
		}
	}
}