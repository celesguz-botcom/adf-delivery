{
	"name": "df_sucursales",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "sucursales_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				},
				{
					"dataset": {
						"referenceName": "restaurantes_csv",
						"type": "DatasetReference"
					},
					"name": "source2"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "sucursales_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "exists1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          sucursal_id as string,",
				"          restaurante_id as string,",
				"          nombre_sucursal as string,",
				"          ciudad as string,",
				"          zona as string,",
				"          direccion as string,",
				"          capacidad_mesas as string,",
				"          tiene_delivery as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source(output(",
				"          restaurante_id as string,",
				"          nombre_restaurante as string,",
				"          tipo_cocina as string,",
				"          calificacion_promedio as string,",
				"          activo as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source2",
				"source1 derive(ciudad = trim(ciudad),",
				"          capacidad_mesas = iif(!regexMatch(toString(capacidad_mesas), '^[0-9]+$'), 20, toInteger(capacidad_mesas)),",
				"          direccion = iif(isNull(direccion), 'Sin dirección registrada', trim(direccion))) ~> derivedColumn1",
				"derivedColumn1, source2 exists(source1@restaurante_id == source2@restaurante_id,",
				"     negate:false,",
				"     broadcast: 'auto')~> exists1",
				"exists1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          sucursal_id as string,",
				"          restaurante_id as string,",
				"          nombre_sucursal as string,",
				"          ciudad as string,",
				"          zona as string,",
				"          direccion as string,",
				"          capacidad_mesas as integer,",
				"          tiene_delivery as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          sucursal_id,",
				"          restaurante_id,",
				"          nombre_sucursal,",
				"          ciudad,",
				"          zona,",
				"          direccion,",
				"          capacidad_mesas,",
				"          tiene_delivery",
				"     )) ~> sink1"
			]
		}
	}
}