{
	"name": "df_detalle_pedidos",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "detalle_pedidos_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				},
				{
					"dataset": {
						"referenceName": "productos_menu_csv",
						"type": "DatasetReference"
					},
					"name": "source2"
				},
				{
					"dataset": {
						"referenceName": "pedidos_csv",
						"type": "DatasetReference"
					},
					"name": "source3"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "detalle_pedidos_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "filter1"
				},
				{
					"name": "exists1"
				},
				{
					"name": "exists2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          detalle_id as string,",
				"          pedido_id as string,",
				"          producto_id as string,",
				"          cantidad as string,",
				"          precio_unitario as string,",
				"          descuento_linea as string,",
				"          total_linea as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source(output(",
				"          producto_id as string,",
				"          nombre_producto as string,",
				"          categoria as string,",
				"          precio_lista as string,",
				"          costo_estimado as string,",
				"          disponible as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source2",
				"source(output(",
				"          pedido_id as string,",
				"          fecha_pedido as string,",
				"          hora_pedido as string,",
				"          cliente_id as string,",
				"          sucursal_id as string,",
				"          canal as string,",
				"          tipo_servicio as string,",
				"          estado_pedido as string,",
				"          promocion_id as string,",
				"          subtotal as string,",
				"          costo_delivery as string,",
				"          descuento as string,",
				"          impuesto as string,",
				"          total_pedido as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source3",
				"source1 derive(precio_unitario = toDecimal(replace(precio_unitario,',','.'),10,2)) ~> derivedColumn1",
				"derivedColumn1 filter(toDecimal(cantidad)>0 && abs(",
				"round(",
				"toDecimal(cantidad)*toDecimal(precio_unitario)",
				"-toDecimal(descuento_linea),",
				"2",
				")",
				"-toDecimal(total_linea)",
				")<=0.5) ~> filter1",
				"filter1, source2 exists(source1@producto_id == source2@producto_id,",
				"     negate:false,",
				"     broadcast: 'auto')~> exists1",
				"exists1, source3 exists(source1@pedido_id == source3@pedido_id,",
				"     negate:false,",
				"     broadcast: 'auto')~> exists2",
				"exists2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          detalle_id as string,",
				"          pedido_id as string,",
				"          producto_id as string,",
				"          cantidad as integer,",
				"          precio_unitario as decimal(10,2),",
				"          descuento_linea as decimal(10,2),",
				"          total_linea as decimal(10,2)",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          detalle_id,",
				"          pedido_id,",
				"          producto_id,",
				"          precio_unitario",
				"     )) ~> sink1"
			]
		}
	}
}