{
	"name": "df_pedidos",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "pedidos_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				},
				{
					"dataset": {
						"referenceName": "clientes_csv",
						"type": "DatasetReference"
					},
					"name": "source2"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "pedidos_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "filter2"
				},
				{
					"name": "exists1"
				},
				{
					"name": "window1"
				},
				{
					"name": "filter1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          pedido_id as string,",
				"          fecha_pedido as string,",
				"          hora_pedido as string,",
				"          cliente_id as string,",
				"          sucursal_id as string,",
				"          canal as string,",
				"          tipo_servicio as string,",
				"          estado_pedido as string,",
				"          promocion_id as string,",
				"          subtotal as string,",
				"          costo_delivery as string,",
				"          descuento as string,",
				"          impuesto as string,",
				"          total_pedido as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source(output(",
				"          cliente_id as string,",
				"          nombre as string,",
				"          email as string,",
				"          telefono as string,",
				"          ciudad as string,",
				"          fecha_registro as string,",
				"          segmento as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source2",
				"source1 derive(promocion_id = iif(isNull(promocion_id), 'SIN_PROMO',trim(promocion_id)),",
				"          canal = iif(trim(upper(canal))=='APP','Aplicacion',trim(canal))) ~> derivedColumn1",
				"filter1 filter(toDecimal(total_pedido)>=0 && abs(round(",
				"toDecimal(subtotal)",
				" - toDecimal(descuento) +toDecimal(impuesto)",
				"+toDecimal( costo_delivery),",
				"2)",
				"-toDecimal(total_pedido)",
				")<=0.5) ~> filter2",
				"filter2, source2 exists(source1@cliente_id == source2@cliente_id,",
				"     negate:false,",
				"     broadcast: 'auto')~> exists1",
				"derivedColumn1 window(over(pedido_id),",
				"     asc(fecha_pedido, true),",
				"     rn = rank()) ~> window1",
				"window1 filter(rn==1) ~> filter1",
				"exists1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          pedido_id as string,",
				"          fecha_pedido as date,",
				"          hora_pedido as timestamp,",
				"          cliente_id as string,",
				"          sucursal_id as string,",
				"          canal as string,",
				"          tipo_servicio as string,",
				"          estado_pedido as string,",
				"          promocion_id as string,",
				"          subtotal as decimal(10,2),",
				"          costo_delivery as decimal(10,2),",
				"          descuento as decimal(10,2),",
				"          impuesto as decimal(10,2),",
				"          total_pedido as decimal(10,2)",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          pedido_id,",
				"          cliente_id,",
				"          sucursal_id,",
				"          canal,",
				"          tipo_servicio,",
				"          estado_pedido,",
				"          promocion_id",
				"     )) ~> sink1"
			]
		}
	}
}