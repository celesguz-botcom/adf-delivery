{
	"name": "df_calificaciones",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "calificaciones_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				},
				{
					"dataset": {
						"referenceName": "pedidos_csv",
						"type": "DatasetReference"
					},
					"name": "source2"
				},
				{
					"dataset": {
						"referenceName": "clientes_csv",
						"type": "DatasetReference"
					},
					"name": "source3"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "calificaciones_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "exists1"
				},
				{
					"name": "exists2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          calificacion_id as string,",
				"          pedido_id as string,",
				"          cliente_id as string,",
				"          fecha_calificacion as string,",
				"          puntuacion as string,",
				"          comentario as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source(output(",
				"          pedido_id as string,",
				"          fecha_pedido as string,",
				"          hora_pedido as string,",
				"          cliente_id as string,",
				"          sucursal_id as string,",
				"          canal as string,",
				"          tipo_servicio as string,",
				"          estado_pedido as string,",
				"          promocion_id as string,",
				"          subtotal as string,",
				"          costo_delivery as string,",
				"          descuento as string,",
				"          impuesto as string,",
				"          total_pedido as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source2",
				"source(output(",
				"          cliente_id as string,",
				"          nombre as string,",
				"          email as string,",
				"          telefono as string,",
				"          ciudad as string,",
				"          fecha_registro as string,",
				"          segmento as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source3",
				"source1 derive(puntuacion = iif(toFloat(puntuacion) > 5, 5.0, iif(toFloat(puntuacion) < 1, 1.0,toFloat(puntuacion))),",
				"          comentario = iif(isNull(comentario), 'Sin comentario', trim(comentario))) ~> derivedColumn1",
				"derivedColumn1, source2 exists(source1@pedido_id == source2@pedido_id,",
				"     negate:false,",
				"     broadcast: 'auto')~> exists1",
				"exists1, source3 exists(source1@cliente_id == source3@cliente_id,",
				"     negate:false,",
				"     broadcast: 'auto')~> exists2",
				"exists2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          calificacion_id as string,",
				"          pedido_id as string,",
				"          cliente_id as string,",
				"          fecha_calificacion as date,",
				"          puntuacion as integer,",
				"          comentario as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          calificacion_id,",
				"          pedido_id,",
				"          cliente_id,",
				"          puntuacion,",
				"          comentario",
				"     )) ~> sink1"
			]
		}
	}
}